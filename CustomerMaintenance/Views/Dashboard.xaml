<UserControl x:Class="CustomerMaintenance.Views.Dashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"             
             xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:oxy="http://oxyplot.org/wpf"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <Style x:Key="HiddenHeaderStyle" TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="8" Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="40"/>
                <RowDefinition />
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>
            <TextBox Grid.Row="0" 
                     Controls:TextBoxHelper.Watermark="名称検索"/>
            <ComboBox Grid.Row="1"
                      Margin="0,10,0,4"
                      ItemsSource="{Binding Sections}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Code"
                      SelectedValue="{Binding SelectedSectionCode}"
                      SelectedItem="{Binding SelectedSection, Mode=TwoWay}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <prism:InvokeCommandAction Command="{Binding SectionSelectionChanged}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ComboBox>

            <ListBox Grid.Row="2"
                     ItemsSource="{Binding Employees}"
                     SelectionMode="Multiple">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Text="{Binding Code}" Margin="4,0,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <prism:InvokeCommandAction 
                            Command="{Binding EmployeeSelectionChanged}" 
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=SelectedItems}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ListBox>
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal">
                <Button Content="All"
                        Width="100"/>
                <Button Content="Clear"
                        Width="100"/>
            </StackPanel>

        </Grid>

        <Grid Grid.Column="1"
              Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="300"/>
            </Grid.RowDefinitions>
            <ListView Grid.Row="0" 
                      Margin="0,0,0,20"
                      ItemsSource="{Binding ExtendedCustomerInfos}" 
                      SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="顧客" DisplayMemberBinding="{Binding Name}" Width="300"/>
                        <GridViewColumn Header="主" DisplayMemberBinding="{Binding PrimaryChargeEmployeeName}" Width="80"/>
                        <GridViewColumn Header="副" DisplayMemberBinding="{Binding SecondaryChargeEmployeeName}" Width="80"/>
                        <GridViewColumn Header="TEL" DisplayMemberBinding="{Binding Tel}" Width="120"/>
                        <GridViewColumn Header="FAX" DisplayMemberBinding="{Binding Fax}" Width="120"/>
                        <GridViewColumn Header="地区" DisplayMemberBinding="{Binding Area}" Width="60"/>
                        <GridViewColumn Header="業種" DisplayMemberBinding="{Binding Industry}" Width="60"/>
                    </GridView>
                </ListView.View>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <prism:InvokeCommandAction 
                            Command="{Binding CustomerSelectionChanged}" 
                            TriggerParameterPath="AddedItems"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ListView>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Grid.Row="0" Grid.Column="0" 
                        BorderBrush="Silver"
                        BorderThickness="4,0,0,0"/>
                <TextBlock Grid.Row="0" Grid.Column="0" 
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="16"
                       Text="案件リスト"/>
                <Border Grid.Row="0" Grid.Column="1" 
                        BorderBrush="Silver"
                        BorderThickness="4,0,0,0"/>
                <TextBlock Grid.Row="0" Grid.Column="1" 
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="16"
                       Text="売上粗利推移"/>

                <ListView Grid.Row="1" Grid.Column="0" 
                          Margin="0,10,0,0"
                          ItemsSource="{Binding Cases}">

                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="確度" DisplayMemberBinding="{Binding Symbol}" Width="35"/>
                            <GridViewColumn Header="案件" DisplayMemberBinding="{Binding CaseName}" Width="160"/>
                            <GridViewColumn Header="売上" Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SalesPrice, StringFormat={}{0:#,0}}" HorizontalAlignment="Right" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="粗利" Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProfitPrice, StringFormat={}{0:#,0}}" HorizontalAlignment="Right" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseDoubleClick">
                            <prism:InvokeCommandAction Command="{Binding OrderDoubleClickCommand}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </ListView>

                <oxy:PlotView Grid.Row="1" Grid.Column="1" 
                              Model="{Binding PlotModel}"/>

            </Grid>
        </Grid>

    </Grid>
</UserControl>