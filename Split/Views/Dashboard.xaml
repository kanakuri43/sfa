<UserControl x:Class="Split.Views.Dashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"             
             xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <Style x:Key="HiddenHeaderStyle" TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="8" Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition />
                <RowDefinition Height="80"/>
                <RowDefinition Height="200"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0"
                            Margin="0,0,0,0"
                            Orientation="Horizontal">
                <ComboBox Width="90"                          
                          ItemsSource="{Binding Years}"
                          SelectedValue="{Binding SelectedYear}"
                          SelectedItem="{Binding SelectedYear, Mode=TwoWay}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectionChanged">
                            <prism:InvokeCommandAction 
                            Command="{Binding YearSelectionChanged}" 
                            TriggerParameterPath="AddedItems"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </ComboBox>
                <ComboBox Width="50"
                          ItemsSource="{Binding Months}"
                          SelectedValue="{Binding SelectedMonth}"
                          SelectedItem="{Binding SelectedMonth, Mode=TwoWay}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectionChanged">
                            <prism:InvokeCommandAction 
                            Command="{Binding MonthSelectionChanged}" 
                            TriggerParameterPath="AddedItems"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </ComboBox>
            </StackPanel>
            <ComboBox Grid.Row="1"
                      Margin="0,0,0,4"
                      ItemsSource="{Binding Sections}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Code"
                      SelectedValue="{Binding SelectedSectionCode}"
                      SelectedItem="{Binding SelectedSection, Mode=TwoWay}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <prism:InvokeCommandAction Command="{Binding SectionSelectionChanged}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ComboBox>

            <ListBox Grid.Row="2"
                     ItemsSource="{Binding Employees}"
                     SelectedValuePath="Code"
                     SelectedValue="{Binding SelectedEmployeeCode}"
                     SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Text="{Binding Code}" Margin="4,0,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <prism:InvokeCommandAction 
                            Command="{Binding EmployeeSelectionChanged}" 
                            TriggerParameterPath="AddedItems"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ListBox>

            <Grid Grid.Row="3"
                  VerticalAlignment="Top"
>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                                       Text="{Binding ProgressLevelMax.Symbol}" 
                                       VerticalAlignment="Center"/>
                <Slider Grid.Column="1" 
                        Margin="4"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Value="{Binding SelectedProgressLevel}"
                        Minimum="0"
                        Maximum="6">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="ValueChanged">
                            <prism:InvokeCommandAction 
                                            Command="{Binding SelectedProgressLevelChanged}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>

                </Slider>

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Text="{Binding ProgressLevelMin.Symbol}"/>

            </Grid>

            <ListView Grid.Row="4" 
                      Margin="0,10,0,10"
                      ItemsSource="{Binding Pipelines}" >

                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource HiddenHeaderStyle}">
                        <GridViewColumn Header="確度" Width="40">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" HorizontalAlignment="Right" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="件数" Width="40">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CaseCount, StringFormat={}{0:#,0}}" HorizontalAlignment="Right" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="達成率" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Controls:MetroProgressBar Value="{Binding Percentage, Mode=OneWay}"
                                                               Maximum="100"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>


        </Grid>
        <Grid Grid.Column="1"
              Margin="30,0,0,0">
            
            <Grid.RowDefinitions>
                <RowDefinition Height="230"/>
                <RowDefinition Height="230"/>
                <RowDefinition />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Grid.Row="0" Grid.Column="0"
                        BorderBrush="Silver"
                        BorderThickness="4,0,0,0"/>
                <TextBlock Grid.Row="0" Grid.Column="0" 
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Text="売上"/>
                <TextBlock Grid.Row="1" Grid.Column="0" 
                                       VerticalAlignment="Center"
                                       Text="目標"/>
                <TextBlock Grid.Row="1" Grid.Column="1" 
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       Text="{Binding CurrentSalesTarget ,StringFormat={}{0:N0}}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" 
                                       VerticalAlignment="Center"
                                       Text="受注済"/>

                <TextBlock Grid.Row="2" Grid.Column="1" 
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       Text="{Binding LatestTotals[0].FinishedSales ,StringFormat={}{0:N0}}"/>
                <TextBlock Grid.Row="2" Grid.Column="2" 
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       Text="{Binding SalesProgressRate ,StringFormat={}{0:N0} %}"/>
                <Controls:MetroProgressBar Grid.Row="2" Grid.Column="3"
                                                       Margin="2"
                                                       Background="LightGray"
                                                       Minimum="0" Maximum="100"
                                                       Value="{Binding SalesProgressRate}" />
                <TextBlock Grid.Row="2" Grid.Column="3" 
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="White"
                           Visibility="{Binding IsSalesCompleted, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Text="Complete"/>

                <TextBlock Grid.Row="3" Grid.Column="0" 
                                       VerticalAlignment="Center"
                                       Text="受注予定"/>
                <TextBlock Grid.Row="3" Grid.Column="1" 
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       Text="{Binding LatestTotals[0].UnfinishedSales ,StringFormat={}{0:N0}}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" 
                                       VerticalAlignment="Center"
                                       Text="合計"/>
                <TextBlock Grid.Row="4" Grid.Column="1" 
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       Text="{Binding LatestTotals[0].TotalSales ,StringFormat={}{0:N0}}"/>
                <TextBlock Grid.Row="4" Grid.Column="2" 
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       Text="{Binding SalesForecastProgressRate ,StringFormat={}{0:N0} %}"/>
                <Controls:MetroProgressBar Grid.Row="4" Grid.Column="3"
                                                       Margin="2"
                                                       Background="LightGray"
                                                       Minimum="0" Maximum="100"
                                                       Value="{Binding SalesForecastProgressRate}" />

            </Grid>
            <Grid Grid.Row="1"     >
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Grid.Row="0" Grid.Column="0"
                        BorderBrush="Silver"
                        BorderThickness="4,0,0,0"/>
                <TextBlock Grid.Row="0" Grid.Column="0" 
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       Text="粗利"/>

                <TextBlock Grid.Row="1" Grid.Column="0" 
                                    VerticalAlignment="Center"
                                    Text="目標"/>
                <TextBlock Grid.Row="1" Grid.Column="1" 
                                    TextAlignment="Right"
                                    VerticalAlignment="Center"
                                    Text="{Binding CurrentProfitTarget, StringFormat={}{0:N0}}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" 
                                       VerticalAlignment="Center"
                                       Text="受注済"/>
                <TextBlock Grid.Row="2" Grid.Column="1" 
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       Text="{Binding LatestTotals[0].FinishedProfit ,StringFormat={}{0:N0}}"/>
                <TextBlock Grid.Row="2" Grid.Column="2" 
                                    TextAlignment="Right"
                                    VerticalAlignment="Center"
                                    Text="{Binding ProfitProgressRate, StringFormat={}{0:N0} %}"/>
                <Controls:MetroProgressBar Grid.Row="2" Grid.Column="3"
                                                       Margin="2"
                                                       Background="LightGray"
                                                       Minimum="0" Maximum="100"
                                                       Value="{Binding ProfitProgressRate}" />
                <TextBlock Grid.Row="2" Grid.Column="3"             
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="White"
                           Visibility="{Binding IsProfitCompleted, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Text="Complete"/>

                <TextBlock Grid.Row="3" Grid.Column="0" 
                            VerticalAlignment="Center"
                            Text="受注予定"/>
                <TextBlock Grid.Row="3" Grid.Column="1" 
                            VerticalAlignment="Center"
                            TextAlignment="Right"
                            Text="{Binding LatestTotals[0].UnfinishedProfit ,StringFormat={}{0:N0}}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" 
                                       VerticalAlignment="Center"
                                       Text="合計"/>
                <TextBlock Grid.Row="4" Grid.Column="1" 
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       Text="{Binding LatestTotals[0].TotalProfit ,StringFormat={}{0:N0}}"/>
                <TextBlock Grid.Row="4" Grid.Column="2" 
                                    TextAlignment="Right"
                                    VerticalAlignment="Center"
                                    Text="{Binding ProfitForecastProgressRate, StringFormat={}{0:N0} %}"/>
                <Controls:MetroProgressBar Grid.Row="4" Grid.Column="3"
                                                       Margin="2"
                                                       Background="LightGray"
                                                       Minimum="0" Maximum="100"
                                                       Value="{Binding ProfitForecastProgressRate}" />


            </Grid>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition />
                </Grid.RowDefinitions>

            </Grid>

        </Grid>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="350"/>
                <RowDefinition Height="30"/>
                <RowDefinition />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" 
                        BorderBrush="Silver"
                        BorderThickness="4,0,0,0"/>
            <TextBlock Grid.Row="0"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="16"
                       Text="Active"/>
            <ListView Grid.Row="1" 
                      Margin="0,10,0,30"
                      ItemsSource="{Binding ActiveCases}" >

                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="確度" DisplayMemberBinding="{Binding Symbol}" Width="35"/>
                        <GridViewColumn Header="顧客" DisplayMemberBinding="{Binding CustomerName}" Width="170"/>
                        <GridViewColumn Header="案件" DisplayMemberBinding="{Binding CaseName}" Width="170"/>
                        <GridViewColumn Header="売上" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SalesPrice, StringFormat={}{0:#,0}}" HorizontalAlignment="Right" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="粗利" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ProfitPrice, StringFormat={}{0:#,0}}" HorizontalAlignment="Right" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <prism:InvokeCommandAction Command="{Binding OrderDoubleClickCommand}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ListView>


            <Border Grid.Row="2" 
                        BorderBrush="Silver"
                        BorderThickness="4,0,0,0"/>
            <TextBlock Grid.Row="2"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="16"
                       Text="Inactive"/>
            <ListView Grid.Row="3" 
                      Margin="0,10,0,30"
                      ItemsSource="{Binding InactiveCases}" >

                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="確度" DisplayMemberBinding="{Binding Symbol}" Width="35"/>
                        <GridViewColumn Header="顧客" DisplayMemberBinding="{Binding CustomerName}" Width="170"/>
                        <GridViewColumn Header="案件" DisplayMemberBinding="{Binding CaseName}" Width="170"/>
                        <GridViewColumn Header="売上" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SalesPrice, StringFormat={}{0:#,0}}" HorizontalAlignment="Right" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="粗利" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ProfitPrice, StringFormat={}{0:#,0}}" HorizontalAlignment="Right" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <prism:InvokeCommandAction Command="{Binding OrderDoubleClickCommand}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ListView>
        </Grid>

    </Grid>
</UserControl>
